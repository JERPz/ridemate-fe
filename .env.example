# RIDEMATE frontend environment
#
# Copy this file to `.env` (or `.env.local`) and adjust the values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of the backend REST API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api

# When "true", the app uses an in-browser mock backend instead of the network.
# Handy for local UI work before the real backend is available.
VITE_USE_MOCK=true

# Request timeout in milliseconds.
VITE_API_TIMEOUT=15000
